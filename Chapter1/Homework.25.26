#Task 8
word = input("Enter a 5-letter word (lowercase): ")
key = int(input("Enter shift key (0-25): "))

encrypted = ""

for letter in word:
    
    num = ord(letter) - ord('a')
    
    new_num = (num + key) % 26
    
    new_letter = chr(new_num + ord('a'))
    encrypted += new_letter

print("Output:", encrypted)

